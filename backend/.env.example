# Copy this file to ".env" and fill in your own values.
# ".env" is git-ignored — never commit real secrets.

PORT=5000

# ---- Supabase ----
# Find these in your Supabase project: Settings → API
# SUPABASE_URL looks like: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# The "anon" / "public" key. This one is fine to be non-secret — it's
# restricted by Row Level Security to only inserting new enquiries
# (see supabase/schema.sql). Used for the public enquiry form.
SUPABASE_ANON_KEY=

# The "service_role" key. This one is NOT public — full database
# access, bypasses Row Level Security entirely. Used only for the
# admin-only operations (list/update/delete), which are already
# protected by ADMIN_KEY below before they ever reach Supabase.
SUPABASE_SERVICE_KEY=

# Any long random string — this protects the admin dashboard & API routes.
# Generate one at https://1password.com/password-generator/ or just mash your keyboard.
ADMIN_KEY=change-this-to-a-long-random-secret

# Allowed origin(s) for CORS — where your frontend is served from.
# For local dev with Live Server this is usually http://127.0.0.1:5500 or http://localhost:5500
# For production, set this to your real domain, e.g. https://visvathaschool.com
CORS_ORIGIN=*

# ---- Optional: email notifications ----
# Leave these blank to skip email notifications (enquiries are still saved either way).
# Example values below are for Gmail — use an "App Password", not your normal password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
